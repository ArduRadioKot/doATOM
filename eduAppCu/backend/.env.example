# Flask
FLASK_SECRET_KEY=change-me-in-production
COOKIE_SECURE=false

# OpenRouter: key is used only by Flask backend and is never sent to the browser.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Optional metadata recommended by OpenRouter.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=DuATOM

# Optional: separate pepper for hashing browser device identifiers.
DEVICE_ID_PEPPER=change-me-too

# Telegram bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_URL=https://t.me/yasno_sub_bot
TELEGRAM_ADMIN_IDS=
